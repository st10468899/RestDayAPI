@model dynamic

@{
    ViewData["Title"] = "Results Entry";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">⏱️ Race Results Entry</h2>
            <p class="text-muted">Record finish times and calculate final placements for enrolled participants.</p>
        </div>
        <a asp-controller="Organiser" asp-action="Dashboard" class="btn btn-outline-dark">Back to Dashboard</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-success text-white fw-bold py-3">
            Publish Results - City Grand Marathon (42 KM)
        </div>
        <div class="card-body p-4">
            <form asp-controller="Organiser" asp-action="SaveResults" method="post">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Finish Time (HH:MM:SS)</th>
                            <th>Finish Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold">Alex Johnson</td>
                            <td>Open Male 42K</td>
                            <td>
                                <input type="text" class="form-control form-control-sm" name="FinishTime" placeholder="02:45:12" required />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" name="Position" placeholder="1" required />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Sarah Williams</td>
                            <td>Open Female 42K</td>
                            <td>
                                <input type="text" class="form-control form-control-sm" name="FinishTime" placeholder="03:02:40" required />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" name="Position" placeholder="2" required />
                            </td>
                        </tr>
                    </tbody>
                </table>

                <button type="submit" class="btn btn-success btn-lg fw-bold shadow mt-3">
                    🚀 Submit & Publish Official Results
                </button>
            </form>
        </div>
    </div>
</div>