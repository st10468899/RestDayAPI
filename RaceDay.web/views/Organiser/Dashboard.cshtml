@model List<RaceDay.Web.Controllers.EventModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 rounded shadow-sm text-white bg-dark">
        <div>
            <h1 class="fw-bold mb-1">🏁 Organiser Control Panel</h1>
            <p class="text-light mb-0">Manage upcoming races, configure event categories, and publish participant results.</p>
        </div>
        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-pink btn-lg fw-bold shadow" style="background-color: #d63384; color: white;">
            ➕ Create New Event
        </a>
    </div>

    <!-- Event Management Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white fw-bold py-3 d-flex justify-content-between align-items-center">
            <span>📋 Event Management</span>
            <span class="badge bg-light text-dark">Live Data</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-secondary">
                    <tr>
                        <th>Event Name</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td class="fw-bold">@ev.Name</td>
                                <td><span class="badge" style="background-color: #d63384; color: white;">@ev.EventType</span></td>
                                <td>@ev.Date</td>
                                <td>@ev.Location</td>
                                <td>@ev.Distance KM</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Organiser" asp-action="ResultsEntry" class="btn btn-sm btn-outline-success">Results</a>

                                        <form asp-controller="Organiser" asp-action="DeleteEvent" method="post" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                            <input type="hidden" name="name" value="@ev.Name" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No events available. Click "Create New Event" to add one!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>