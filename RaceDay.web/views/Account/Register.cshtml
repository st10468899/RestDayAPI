@{
    ViewData["Title"] = "Register Account";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-warning text-dark text-center py-3">
                <h3 class="fw-bold mb-0">🏎️ RaceDay Account Registration</h3>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input name="FullName" type="text" class="form-control" placeholder="Enter full name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input name="Email" type="email" class="form-control" placeholder="name@example.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Role</label>
                        <select name="Role" class="form-select" required>
                            <option value="Participant">Participant</option>
                            <option value="Organiser">Organiser</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <input name="Password" type="password" class="form-control" placeholder="Create password" required />
                    </div>

                    <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold text-dark shadow mt-3">
                        🚀 Complete Registration
                    </button>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                <small>Already have an account? <a asp-controller="Account" asp-action="Login" class="fw-bold text-primary">Login here</a></small>
            </div>
        </div>
    </div>
</div>