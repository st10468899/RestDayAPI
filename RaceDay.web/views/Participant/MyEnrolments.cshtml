@model List<RaceDay.Web.Controllers.EnrolmentModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">📋 My Event Enrolments</h2>
            <p class="text-muted mb-0">View all your registered events and track your current status.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn text-white fw-bold" style="background-color: #d63384;">➕ Browse More Events</a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Event Name</th>
                            <th>Category</th>
                            <th>Enrolment Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.EventName</td>
                                <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                                <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-success fs-6">@item.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div> 
        </div>
    } 
    else
    { 
        <div class="card border-0 shadow-sm p-4 text-center mt-3">
            <div class="alert alert-info mb-3">
                <h5 class="fw-bold">You have not enrolled in any events yet!</h5>
                <p class="mb-0">Explore our upcoming races and sign up today.</p>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn text-white fw-bold px-4 shadow" style="background-color: #d63384;">Explore Events</a>
            </div>
        </div> 
    }
</div>